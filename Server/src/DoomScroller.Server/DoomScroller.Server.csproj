<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DoomScroller.Server</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
  <!-- Shared combat library: linked, never copied. Unity owns the files; 016 wires usage.
       Empty until task 008 creates the folder. -->
  <PropertyGroup>
    <CombatCoreDir>$(MSBuildThisFileDirectory)../../../Assets/Scripts/CombatCore/</CombatCoreDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(CombatCoreDir)')">
    <Compile Include="$(CombatCoreDir)**/*.cs" Exclude="$(CombatCoreDir)**/obj/**;$(CombatCoreDir)**/bin/**" LinkBase="CombatCore" />
  </ItemGroup>
</Project>
